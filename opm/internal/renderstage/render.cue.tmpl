// GENERATED by the OPM kernel for one render (enhancement 0019 D9). The
// render module is the main module of a single CUE build: the instance and
// the platform enter by import through cue.mod/local-module.cue directory
// replacements, the catalog arrives through the platform's own imports, and
// the kernel reads `diagnostics` and `rendered` off the built value.
//
// Matching is experiment 05's measured shape (0019 D10): buckets folded from
// the platform's derived #composedTransformers, the always-unify rung as
// plain `&` (one build, one set of catalog bytes: no provenance carve-out),
// the predicate rung, every verdict as data behind `== _|_` guards, and the
// fail-closed demand gate (0010 D28) as one unification.
package render

import (
	"list"
	"regexp"
	"strconv"
	"strings"

	instance <<.InstanceImport>>
	platform <<.PlatformImport>>
)

// Identity of the executing runtime: the runtime's whole remaining
// obligation to #context (0019 D12). Rendered as a literal by the kernel.
_runtimeName: <<.RuntimeName>>

_transformers: platform.#composedTransformers
_components:   instance.components

// ── The D34/D4 apiVersion ladder, in the build.
//
// #ladder classifies a contract key's apiVersion (the substring after the
// final "@") on the Kubernetes ladder: vNalphaM -> vNbetaM -> vN. The grammar
// is core's #APIVersionType, so a digit after alpha/beta is required and
// "v1alpha" is invalid. An invalid key is ordered, never dropped.
#ladder: {
	key:    string
	_parts: strings.Split(key, "@")
	_ver:   _parts[len(_parts)-1]

	valid: regexp.Match(#"^v[0-9]+((alpha|beta)[0-9]+)?$"#, _ver)

	if valid {
		_m:    regexp.FindSubmatch(#"^v([0-9]+)(?:(alpha|beta)([0-9]+))?$"#, _ver)
		major: strconv.Atoi(_m[1])
		level: [if _m[2] == "alpha" {0}, if _m[2] == "beta" {1}, if _m[2] == "" {2}][0]
		minor: [if _m[3] == "" {0}, if _m[3] != "" {strconv.Atoi(_m[3])}][0]
	}
	if !valid {
		major: 0
		level: 0
		minor: 0
	}
}

// #apiVersionLess is a list.Sort comparator over contract keys: level first
// (alpha < beta < GA), then major, then the alpha/beta number, then the key
// string so the order is total. A key outside the grammar sorts before every
// valid one, lexically among themselves. This is the only apiVersion ladder
// in the render path; the kernel copies the sorted list.
#apiVersionLess: {
	x: string
	y: string
	_x: #ladder & {key: x}
	_y: #ladder & {key: y}
	less: [
		if _x.valid != _y.valid {_y.valid},
		if !_x.valid && !_y.valid {x < y},
		if _x.valid && _y.valid && _x.level != _y.level {_x.level < _y.level},
		if _x.valid && _y.valid && _x.level == _y.level && _x.major != _y.major {_x.major < _y.major},
		if _x.valid && _y.valid && _x.level == _y.level && _x.major == _y.major && _x.minor != _y.minor {_x.minor < _y.minor},
		if _x.valid && _y.valid && _x.level == _y.level && _x.major == _y.major && _x.minor == _y.minor {x < y},
	][0]
}

// #base is a contract key without its trailing "@version".
#base: {
	fqn:    string
	_parts: strings.Split(fqn, "@")
	out: [
		if len(_parts) == 1 {fqn},
		if len(_parts) > 1 {strings.Join(list.Slice(_parts, 0, len(_parts)-1), "@")},
	][0]
}

// #alternatives is every OTHER key in a demand's own bucket universe sharing
// its base: "a transformer exists for a different version of this primitive",
// in ladder order (0010 D34/D4), so the row is deterministic.
#alternatives: {
	universe: {[string]: _}
	fqn:      string
	_want:    (#base & {"fqn": fqn}).out
	out: list.Sort([
		for _k, _ in universe
		if _k != fqn
		if (#base & {fqn: _k}).out == _want {_k},
	], #apiVersionLess)
}

#Match: {
	#transformers: [string]: _
	#components: [string]:   _

	// ── Rung 1 index: primitive FQN -> transformers whose required ∪
	// optional maps name it. A transformer is only ever CONSIDERED through
	// a bucket some demanded FQN reaches.
	_bucketsResources: {
		for tfqn, tf in #transformers {
			if tf.requiredResources != _|_ {
				for fqn, _ in tf.requiredResources {(fqn): (tfqn): true}
			}
			if tf.optionalResources != _|_ {
				for fqn, _ in tf.optionalResources {(fqn): (tfqn): true}
			}
		}
	}
	_bucketsTraits: {
		for tfqn, tf in #transformers {
			if tf.requiredTraits != _|_ {
				for fqn, _ in tf.requiredTraits {(fqn): (tfqn): true}
			}
			if tf.optionalTraits != _|_ {
				for fqn, _ in tf.optionalTraits {(fqn): (tfqn): true}
			}
		}
	}

	// ── Per-component verdicts.
	verdicts: {
		for cid, comp in #components {
			(cid): {
				_resFqns: [for fqn, _ in comp.#resources {fqn}]
				_traitFqns: [if comp.#traits != _|_ for fqn, _ in comp.#traits {fqn}]

				// Rung 2, always-unify: plain `&` over every FQN present on
				// both sides; "structurally agrees" is "not bottom", which
				// `== _|_` answers without letting the bottom escape.
				_unify: {
					for tfqn, tf in #transformers {
						(tfqn): {
							conflicts: [
								if tf.requiredResources != _|_
								for fqn, req in tf.requiredResources
								if comp.#resources[fqn] != _|_
								if (comp.#resources[fqn] & req) == _|_ {fqn},
								if tf.requiredTraits != _|_
								for fqn, req in tf.requiredTraits
								if comp.#traits[fqn] != _|_
								if (comp.#traits[fqn] & req) == _|_ {fqn},
							]
							ok: len(conflicts) == 0
						}
					}
				}

				// Rung 3, predicate: required labels, resources and traits
				// all present. Label values are unified, so every type
				// #LabelsAnnotationsType admits is compared.
				_pred: {
					for tfqn, tf in #transformers {
						(tfqn): {
							missingLabels: [
								if tf.requiredLabels != _|_
								for k, v in tf.requiredLabels
								if (comp.matchLabels[k] & v) == _|_ {k},
							]
							missingResources: [
								if tf.requiredResources != _|_
								for fqn, _ in tf.requiredResources
								if comp.#resources[fqn] == _|_ {fqn},
							]
							missingTraits: [
								if tf.requiredTraits != _|_
								for fqn, _ in tf.requiredTraits
								if comp.#traits[fqn] == _|_ {fqn},
							]
							ok: len(missingLabels) == 0 &&
								len(missingResources) == 0 &&
								len(missingTraits) == 0
						}
					}
				}

				// Rung 1 walk: only transformers reachable through a
				// demanded FQN's bucket are candidates.
				_candidates: {
					for _, fqn in _resFqns if _bucketsResources[fqn] != _|_ {
						for tfqn, _ in _bucketsResources[fqn] {(tfqn): true}
					}
					for _, fqn in _traitFqns if _bucketsTraits[fqn] != _|_ {
						for tfqn, _ in _bucketsTraits[fqn] {(tfqn): true}
					}
				}

				matched: {
					for tfqn, _ in _candidates
					if _unify[tfqn].ok
					if _pred[tfqn].ok {(tfqn): true}
				}

				// D28 per-demand resolution: satisfied iff some candidate in
				// ITS bucket survived both rungs; an empty bucket and an
				// all-disqualified bucket are one verdict with different
				// `disqualified` contents.
				_resOutcome: {
					for _, fqn in _resFqns {
						(fqn): {
							satisfied: len([
								if _bucketsResources[fqn] != _|_
								for tfqn, _ in _bucketsResources[fqn]
								if _unify[tfqn].ok
								if _pred[tfqn].ok {tfqn},
							]) > 0
							disqualified: [
								if _bucketsResources[fqn] != _|_
								for tfqn, _ in _bucketsResources[fqn]
								if !_unify[tfqn].ok {{
									component:   cid
									transformer: tfqn
									conflicts:   _unify[tfqn].conflicts
								}},
							]
						}
					}
				}
				unresolvedResources: [
					for _, _f in _resFqns if !_resOutcome[_f].satisfied {
						{
							kind:         "resource"
							fqn:          _f
							alternatives: (#alternatives & {universe: _bucketsResources, fqn: _f}).out
							disqualified: _resOutcome[_f].disqualified
						}
					},
				]

				_traitOutcome: {
					for _, fqn in _traitFqns {
						(fqn): {
							satisfied: len([
								if _bucketsTraits[fqn] != _|_
								for tfqn, _ in _bucketsTraits[fqn]
								if _unify[tfqn].ok
								if _pred[tfqn].ok {tfqn},
							]) > 0
							disqualified: [
								if _bucketsTraits[fqn] != _|_
								for tfqn, _ in _bucketsTraits[fqn]
								if !_unify[tfqn].ok {{
									component:   cid
									transformer: tfqn
									conflicts:   _unify[tfqn].conflicts
								}},
							]
						}
					}
				}
				// A trait is handled if its own bucket satisfied, or any
				// MATCHED transformer lists it in optionalTraits.
				_optionalCovered: {
					for tfqn, _ in matched
					if #transformers[tfqn].optionalTraits != _|_ {
						for fqn, _ in #transformers[tfqn].optionalTraits {(fqn): true}
					}
				}
				_handled: {
					for _, fqn in _traitFqns {
						(fqn): _traitOutcome[fqn].satisfied || _optionalCovered[fqn] != _|_
					}
				}
				// Posture split (0010 D28/D46). Guards resolve defaults, so
				// a stated `bool | *true` lands in warnings and `bool |
				// *false` in unresolved. An UNSTATED plain `bool` makes both
				// guards incomplete: fail-closed survives as an
				// incomplete-value build error at the trait's own `optional`.
				unhandledWarnings: [
					for _, fqn in _traitFqns
					if !_handled[fqn]
					if comp.#traits[fqn].optional {fqn},
				]
				unresolvedTraits: [
					for _, _f in _traitFqns
					if !_handled[_f]
					if !comp.#traits[_f].optional {
						{
							kind:         "trait"
							fqn:          _f
							alternatives: (#alternatives & {universe: _bucketsTraits, fqn: _f}).out
							disqualified: _traitOutcome[_f].disqualified
						}
					},
				]
			}
		}
	}

	// ── Flattened verdicts, every one plain data.
	pairs: [
		for cid, v in verdicts
		for tfqn, _ in v.matched {{component: cid, transformer: tfqn}},
	]
	// One row per unmatched component carrying every candidate the rung-1
	// walk reached for it, with the predicate rung's verdict (which required
	// labels the component's matchLabels lacked or carried with a different
	// value). A candidate the always-unify rung refused appears unmatched
	// with no missing labels; its conflict is on unifyFailures. Sorted by
	// component then transformer so the diagnosis is deterministic.
	unmatched: list.Sort([
		for cid, v in verdicts if len(v.matched) == 0 {{
			component: cid
			candidates: list.Sort([
				for tfqn, _ in v._candidates {{
					transformer:   tfqn
					matched:       v.matched[tfqn] != _|_
					missingLabels: v._pred[tfqn].missingLabels
				}},
			], {x: _, y: _, less: x.transformer < y.transformer})
		}},
	], {x: _, y: _, less: x.component < y.component})
	unresolved: [
		for cid, v in verdicts
		for _, u in v.unresolvedResources {{u, component: cid}},
		for cid, v in verdicts
		for _, u in v.unresolvedTraits {{u, component: cid}},
	]
	warnings: [
		for cid, v in verdicts
		for _, _f in v.unhandledWarnings {{component: cid, fqn: _f}},
	]
	// Every CANDIDATE the always-unify rung disqualified, with the
	// conflicting FQNs, whether or not the demand later resolved through
	// another candidate.
	unifyFailures: [
		for cid, v in verdicts
		for tfqn, u in v._unify
		if v._candidates[tfqn] != _|_
		if !u.ok {{component: cid, transformer: tfqn, conflicts: u.conflicts}},
	]
	resolved: len(unresolved) == 0 && len(unmatched) == 0
}

match: #Match & {
	#transformers: _transformers
	#components:   _components
}

// ── Single-provider guard (0010 D32/D37), in-build since
// library-render-cutover. For every enabled registry entry, every
// transformer it contributes and every REQUIRED contract that transformer
// declares with `fulfilment: "provider"`, the entry's registry key is
// collected per contract key. Provenance is the registry key (core binds it
// to the embedded catalog's metadata.modulePath, so it is the path@major
// string), never a value parsed off an FQN or read off the transformer. A
// key supplied by more than one entry is an over-subscription row and the
// gate refuses. Divergent fulfilment across copies cannot occur in one build
// (one set of catalog bytes) and is not checked; default (catalog)
// fulfilment admits any number of suppliers.
guard: {
	_providerSuppliers: {
		for rkey, entry in platform.#registry if entry.enable
		for _, tf in entry.#transformers {
			if tf.requiredResources != _|_ {
				for fqn, req in tf.requiredResources
				if req.fulfilment == "provider" {(fqn): (rkey): true}
			}
			if tf.requiredTraits != _|_ {
				for fqn, req in tf.requiredTraits
				if req.fulfilment == "provider" {(fqn): (rkey): true}
			}
		}
	}
	overSubscribed: list.Sort([
		for _k, suppliers in _providerSuppliers
		if len(suppliers) > 1 {{
			key:      _k
			catalogs: list.Sort([for rkey, _ in suppliers {rkey}], list.Ascending)
		}},
	], {x: _, y: _, less: x.key < y.key})
}

// Each matched pair's #transform, unified with all three inputs whole:
// #moduleInstance and #component as imported (siblings, definitions and
// hidden fields intact), #context's metadata blocks projected by core from
// them, #runtimeName supplied here. Keyed by pair so an incomplete output is
// caught by the kernel's concreteness check at a path naming the pair.
rendered: {
	for p in match.pairs {
		"\(p.component) :: \(p.transformer)": {
			component:   p.component
			transformer: p.transformer
			output: (_transformers[p.transformer].#transform & {
				#moduleInstance: instance
				#component:      _components[p.component]
				#context: #runtimeName: _runtimeName
			}).output
		}
	}
}

diagnostics: {
	pairs:          match.pairs
	unmatched:      match.unmatched
	unresolved:     match.unresolved
	warnings:       match.warnings
	unifyFailures:  match.unifyFailures
	overSubscribed: guard.overSubscribed
	// Every attached trait's effective posture. A posture the catalog never
	// stated is an incomplete bool here, which is how the kernel names the
	// trait behind an otherwise anonymous non-concrete verdict.
	traitPostures: {
		for cid, comp in _components if comp.#traits != _|_ {
			(cid): {
				for fqn, tr in comp.#traits {(fqn): optional: tr.optional}
			}
		}
	}
	// Error-class pair failures as data: an output that is bottom. An
	// INCOMPLETE output is not bottom and is caught by the kernel's per-pair
	// concreteness check instead (measured boundary, 0019 D10).
	failedPairs: [
		for p in match.pairs
		let applied = (_transformers[p.transformer].#transform & {
			#moduleInstance: instance
			#component:      _components[p.component]
			#context: #runtimeName: _runtimeName
		}).output
		if applied == _|_ {p},
	]
}

// The fail-closed gate (0010 D28, D37) as one unification: an unresolved
// demand, an unmatched component or an over-subscribed provider-fulfilled
// contract refuses the build here, while `diagnostics` stays readable and
// concrete beside it through the Go API.
gate: match.resolved & (len(guard.overSubscribed) == 0) & true
