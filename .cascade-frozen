# Test files that keep an OPM-owned version literal on purpose. Read by the
# release-cascade tooling (workspace RELEASING.md, section "Cascade files"):
# the bot never rewrites a version literal at a listed path. Expectations of
# the current core or the pinned catalog build are never literals here; they
# read registrytest.DefaultCoreVersion or the parity module's cue.mod pin.
frozen:
  - path: opm/kernel/render_collision_test.go
    pins: ["opmodel.dev/core@v2"]
    reason: "Re-pins a fixture copy to core v2.0.0-alpha.12, the release before the collision report, so the value is the point."
  - path: opm/kernel/render_core_floor_test.go
    pins: ["opmodel.dev/core@v2"]
    reason: "Re-pins fixture copies to core v2.0.0-alpha.10 and v2.0.0-alpha.12, just below and at the render floor."
  - path: opm/platform/contracts_test.go
    pins: ["opmodel.dev/core@v2"]
    reason: "Exercises the floor and pre-collision inventory semantics of cores v2.0.0-alpha.9 to v2.0.0-alpha.12."
  - path: opm/errors/coretooold_test.go
    pins: ["opmodel.dev/core@v2"]
    reason: "Asserts error text that names the old cores v2.0.0-alpha.10 and v2.0.0-alpha.12."
  - path: opm/helper/platformmodule/closure_test.go
    pins: ["opmodel.dev/core@v2", "opmodel.dev/catalogs/opm@v4"]
    reason: "The literals are nodes of an in-memory fake module graph that is never resolved, not pins."
  - path: opm/helper/platformmodule/generate_test.go
    pins: ["opmodel.dev/core@v2", "opmodel.dev/catalogs/opm@v4"]
    reason: "Synthetic inputs to golden module-file generation and an explicit core pin, independent of the current pins."
  - path: opm/internal/renderstage/modfile_test.go
    pins: ["opmodel.dev/core@v2", "opmodel.dev/catalogs/opm@v4"]
    reason: "Synthetic in-memory module files and skew rows that are parsed and compared, never resolved."
  - path: opm/internal/renderstage/stage_test.go
    pins: ["opmodel.dev/core@v2", "opmodel.dev/catalogs/opm@v4"]
    reason: "Only the local-file core pin and the v4.2.0 catalog on the synthetic platformModFile are frozen; the authored module files read registrytest.DefaultCoreVersion."
  - path: opm/catalog/requires_test.go
    pins: ["opmodel.dev/core@v2"]
    reason: "A synthetic test.example module file read from an overlay and never resolved."
  - path: opm/helper/objectset/objectset_test.go
    pins: ["opmodel.dev/catalogs/opm@v4"]
    reason: "A synthetic transformer id on an in-memory value, never resolved."
  - path: opm/internal/registrytest/registrytest_test.go
    pins: ["opmodel.dev/core@v2"]
    reason: "Synthetic inputs to the Major parse table."
  - path: opm/schema/loader_test.go
    pins: ["opmodel.dev/core@v2"]
    reason: "Only the PinnedVersion parse-table rows are frozen; the default-pin assertions check shape and spell no release."
